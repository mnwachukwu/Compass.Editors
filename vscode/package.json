{
  "name": "compass-editor",
  "displayName": "Compass Editor",
  "description": "Syntax highlighting, debugging, and a language server for Compass.",
  "version": "1.0.2",
  "publisher": "Pluperfect",
  "license": "MIT",
  "icon": "icon.png",

  "galleryBanner": {
    "color": "#14161a",
    "theme": "dark"
  },

  "homepage": "https://compass.pluperfect.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/mnwachukwu/Compass.Editors"
  },
  "bugs": {
    "url": "https://github.com/mnwachukwu/Compass.Editors/issues"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "main": "./extension.js",
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Formatters"
  ],
  "keywords": [
    "compass",
    "programming language",
    "introductory",
    "education",
    "debugger",
    "syntax highlighting",
    "language server",
    "fractions"
  ],
  "activationEvents": [
    "onDebugResolve:compass",
    "onDebugDynamicConfigurations:compass",
    "onLanguage:compass",
    "onLanguage:compass-project"
  ],
  "contributes": {
    "configurationDefaults": {
      "[compass]": {
        "editor.formatOnType": true
      }
    },
    "languages": [
      {
        "id": "compass",
        "aliases": [
          "Compass",
          "compass"
        ],
        "extensions": [
          ".cm"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "compass-project",
        "aliases": [
          "Compass Project"
        ],
        "extensions": [
          ".cmp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "compass",
        "scopeName": "source.compass",
        "path": "./syntaxes/compass.tmLanguage.json"
      },
      {
        "language": "compass-project",
        "scopeName": "source.compass-project",
        "path": "./syntaxes/compass-project.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "compass.runFile",
        "title": "Run this file",
        "category": "Compass",
        "icon": "$(play)"
      },
      {
        "command": "compass.runProject",
        "title": "Run project associated with this file",
        "category": "Compass",
        "icon": "$(run-all)"
      },
      {
        "command": "compass.buildFile",
        "title": "Build this file",
        "category": "Compass"
      },
      {
        "command": "compass.buildProject",
        "title": "Build project associated with this file",
        "category": "Compass"
      },
      {
        "command": "compass.newProject",
        "title": "New project",
        "category": "Compass"
      },
      {
        "command": "compass.addToProject",
        "title": "Add this file to a project",
        "category": "Compass"
      },
      {
        "command": "compass.removeFromProject",
        "title": "Remove this file from its project",
        "category": "Compass"
      },
      {
        "command": "compass.setEntryPoint",
        "title": "Start the project at this file",
        "category": "Compass"
      },
      {
        "command": "compass.setOutputFolder",
        "title": "Build this project into a folder",
        "category": "Compass"
      },
      {
        "command": "compass.chooseTarget",
        "title": "Choose the target platform",
        "category": "Compass"
      },
      {
        "command": "compass.useTheColors",
        "title": "Use the Compass colors",
        "category": "Compass"
      },
      {
        "command": "compass.restartTheServer",
        "title": "Restart the language server",
        "category": "Compass"
      },
      {
        "command": "compass.stopTheServer",
        "title": "Stop the language server",
        "category": "Compass"
      }
    ],
    "submenus": [
      {
        "id": "compass.build",
        "label": "Build",
        "icon": "$(tools)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "compass.runFile",
          "group": "navigation@1",
          "when": "resourceLangId == compass"
        },
        {
          "command": "compass.runProject",
          "group": "navigation@2",
          "when": "resourceLangId == compass || resourceLangId == compass-project"
        }
      ],
      "editor/title": [
        {
          "submenu": "compass.build",
          "group": "navigation@-0.5",
          "when": "resourceLangId == compass || resourceLangId == compass-project"
        }
      ],
      "compass.build": [
        {
          "command": "compass.buildFile",
          "group": "1_what@1",
          "when": "resourceLangId == compass"
        },
        {
          "command": "compass.buildProject",
          "group": "1_what@2"
        },
        {
          "command": "compass.setOutputFolder",
          "group": "2_where@1",
          "when": "resourceLangId == compass || resourceLangId == compass-project"
        },
        {
          "command": "compass.chooseTarget",
          "group": "2_where@2"
        }
      ],
      "explorer/context": [
        {
          "command": "compass.addToProject",
          "group": "compass@1",
          "when": "resourceLangId == compass"
        },
        {
          "command": "compass.removeFromProject",
          "group": "compass@2",
          "when": "resourceLangId == compass"
        },
        {
          "command": "compass.setEntryPoint",
          "group": "compass@3",
          "when": "resourceLangId == compass"
        },
        {
          "command": "compass.setOutputFolder",
          "group": "compass@4",
          "when": "resourceLangId == compass || resourceLangId == compass-project"
        }
      ],
      "commandPalette": [
        {
          "command": "compass.runFile",
          "when": "resourceLangId == compass || resourceLangId == compass-project"
        },
        {
          "command": "compass.runProject",
          "when": "resourceLangId == compass || resourceLangId == compass-project"
        },
        {
          "command": "compass.addToProject",
          "when": "resourceLangId == compass"
        },
        {
          "command": "compass.removeFromProject",
          "when": "resourceLangId == compass"
        },
        {
          "command": "compass.setEntryPoint",
          "when": "resourceLangId == compass"
        },
        {
          "command": "compass.setOutputFolder",
          "when": "resourceLangId == compass || resourceLangId == compass-project"
        }
      ]
    },
    "breakpoints": [
      {
        "language": "compass"
      }
    ],
    "debuggers": [
      {
        "type": "compass",
        "label": "Compass",
        "languages": [
          "compass",
          "compass-project"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .cm file or .cmp project to debug. Naming a .cm file debugs it together with the shared code beside it, the same way 'cm run' does.",
                "default": "${file}"
              },
              "compilerPath": {
                "type": "string",
                "description": "The cm command to run for this configuration, overriding the compass.compilerPath setting."
              },
              "scope": {
                "type": "string",
                "enum": [
                  "file",
                  "project"
                ],
                "default": "file",
                "description": "Whether to run the program named, or the .cmp project nearest it. 'project' looks upward from the program for one, and runs the program itself where there is none."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "compass",
            "request": "launch",
            "name": "Run this file",
            "program": "${file}",
            "internalConsoleOptions": "openOnSessionStart"
          },
          {
            "type": "compass",
            "request": "launch",
            "name": "Run project associated with this file",
            "program": "${file}",
            "scope": "project",
            "internalConsoleOptions": "openOnSessionStart"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Compass: run this file",
            "description": "Runs whichever Compass file is in front of you when you start.",
            "body": {
              "type": "compass",
              "request": "launch",
              "name": "Run this file",
              "program": "^\"\\${file}\"",
              "internalConsoleOptions": "openOnSessionStart"
            }
          },
          {
            "label": "Compass: run project associated with this file",
            "description": "Runs the .cmp project nearest the open file, searching upward.",
            "body": {
              "type": "compass",
              "request": "launch",
              "name": "Run project associated with this file",
              "program": "^\"\\${file}\"",
              "scope": "project",
              "internalConsoleOptions": "openOnSessionStart"
            }
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "compass",
        "required": [
          "scope"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "file",
              "project"
            ],
            "description": "Whether to build the open file, or the .cmp project nearest it."
          },
          "program": {
            "type": "string",
            "description": "What to build. Defaults to the file in front of you."
          },
          "runtime": {
            "type": "string",
            "description": "The platform to build for. Defaults to the compass.targetPlatform setting, and to this machine where that is unset."
          },
          "out": {
            "type": "string",
            "description": "Where to write the build. Defaults to a 'bin' beside the program."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "compass-error",
        "owner": "compass",
        "source": "compass",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "severity": "error",
        "pattern": {
          "regexp": "^(.*)\\((\\d+),(\\d+)\\): error (CM\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      },
      {
        "name": "compass-warning",
        "owner": "compass",
        "source": "compass",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "severity": "warning",
        "pattern": {
          "regexp": "^(.*)\\((\\d+),(\\d+)\\): warning (CM\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      },
      {
        "name": "compass-opinion",
        "owner": "compass",
        "source": "compass",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "severity": "info",
        "pattern": {
          "regexp": "^(.*)\\((\\d+),(\\d+)\\): opinion (CM\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      }
    ],
    "configuration": {
      "title": "Compass",
      "properties": {
        "compass.targetPlatform": {
          "type": "string",
          "default": "",
          "description": "The platform a build targets, as .NET names one — win-x64, linux-x64, osx-arm64. Empty means this machine. Choose from the ones installed with 'Compass: Choose the target platform', which only offers what can actually be built for."
        },
        "compass.compilerPath": {
          "type": "string",
          "default": "cm",
          "description": "The Compass compiler to run when debugging. The default finds it on PATH, which is where installing Compass puts it. Give a full path where it is installed somewhere else, or to debug against a build of the compiler itself."
        },
        "compass.inlayHints.types": {
          "type": "boolean",
          "default": false,
          "description": "Write in the type of a name the program gave none: a 'let', and the binding of each kind of loop. These are the only places in Compass where a type is not written down. Off by default, because a hint is text the editor writes into code nobody wrote — worth turning on while learning what the checker concludes from an initializer."
        },
        "compass.inlayHints.parameterNames": {
          "type": "boolean",
          "default": false,
          "description": "Write the name of the parameter in front of each argument of a call. Off by default: it repeats what hovering the argument already says, and it lands on every argument of every call. Worth turning on while reading unfamiliar code."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  }
}
