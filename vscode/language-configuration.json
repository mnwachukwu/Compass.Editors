{
  "comments": {
    "lineComment": "#",
    "blockComment": ["##", "##"]
  },

  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],

  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],

  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["'", "'"]],

  "wordPattern": "(@?[^\\s`~!@#%^&*()\\-=+\\[{\\]}\\\\|;:'\",.<>/?]+)",

  "indentationRules": {
    "increaseIndentPattern": "^\\s*((abstract|internal|override|protected|public|sealed|shared|virtual)\\s+)*(namespace|model|structure|enumeration|function|loop|if|else|switch|case|default|try|catch|finally|begin)\\b(?!.*\\bend\\b)(?!.*;\\s*$).*$|^.*\\bfunction\\b[^()]*\\([^()]*(?:\\([^()]*\\)[^()]*)*\\)\\s*$",
    "decreaseIndentPattern": "^\\s*(end|until|else|catch|finally|case|default)\\b"
  },

  "onEnterRules": [
    {
      "beforeText": "^\\s*##\\s*$",
      "action": { "indent": "indent" }
    }
  ]
}
