<Project>

  <!--
    Shared settings, matching Profi-C's so that code moving between the two repositories
    is held to the same standard rather than a looser one.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Profi-C</Product>
    <Authors>Matt Nwachukwu</Authors>
    <Company>Profi-C</Company>
    <Copyright>Copyright (c) Matt Nwachukwu</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

</Project>
