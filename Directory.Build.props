<Project>

  <!--
    Shared settings, matching Compass's so that code moving between the two repositories
    is held to the same standard rather than a looser one.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Compass</Product>
    <Authors>Matt Nwachukwu</Authors>
    <Company>Pluperfect Development</Company>
    <Copyright>Copyright (c) Matt Nwachukwu</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <VersionPrefix>1.0.0</VersionPrefix>
  </PropertyGroup>

</Project>
